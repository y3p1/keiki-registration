# Supabase Postgres — Session pooler string (IPv4, port 5432).
# Settings -> Database -> Connection string -> Session pooler.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public base URL for Stripe success/cancel redirects
APP_BASE_URL=http://localhost:3000

# n8n confirmation-email webhook (Production URL of the imported flow).
# Leave unset to skip the email — finalization still works.
N8N_WEBHOOK_URL=

# Minimal v1 auth
SESSION_SECRET=change-me-to-a-long-random-string   # signs parent/staff cookies
STAFF_SECRET=staff-demo                             # staff gate password
